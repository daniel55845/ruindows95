#!/usr/bin/env bash
set -Eeuo pipefail
[[ $EUID == 0 && -d /run/archiso ]] || { echo 'Execute apenas no ambiente live como root.'; exit 1; }
exec 9>/run/ruindows-install.lock
flock -n 9 || { echo 'Já existe uma instalação em andamento.'; exit 1; }
# Never offer a disk with mounted descendants, active swap, or live medium.
bootdev=$(findmnt -nro SOURCE /run/archiso/bootmnt || true)
[[ -n "$bootdev" ]] || { echo 'Não consegui identificar a mídia live. Instalação bloqueada por segurança.'; exit 1; }
bootdev=${bootdev%%\[*}; bootdev=$(readlink -f "$bootdev")
[[ -b "$bootdev" ]] || { echo 'Mídia live não identificada como dispositivo de bloco; instalação bloqueada.'; exit 1; }
mapfile -t excluded < <(lsblk -snrpo NAME "$bootdev")
safe_disk() {
  local d=$1 node
  [[ -b "$d" && $(lsblk -dnro TYPE "$d") == disk && $(lsblk -dnro RO "$d") == 0 ]] || return 1
  for node in "${excluded[@]}"; do [[ "$d" != "$node" ]] || return 1; done
  [[ -z $(lsblk -nrpo MOUNTPOINTS "$d" | tr -d '[:space:]') ]] || return 1
  # Reject device mapper / RAID / other active holders.
  while read -r node; do [[ $(lsblk -dnro TYPE "$node") =~ ^(disk|part)$ ]] || return 1; done < <(lsblk -nrpo NAME "$d")
  [[ $(blockdev --getsize64 "$d") -ge 17179869184 ]] || return 1
}
mode=BIOS; [[ ! -d /sys/firmware/efi ]] || mode=UEFI
if [[ $mode == UEFI && $(cat /sys/firmware/efi/fw_platform_size) != 64 ]]; then echo 'UEFI 32 bits não suportado.'; exit 1; fi
title() { printf '\n\033[1;95m+------------------------------------------------------------------+\033[0m\n'; printf '\033[1;95m| %-64s |\033[0m\n' "$1"; printf '\033[1;95m+------------------------------------------------------------------+\033[0m\n'; }
welcome() {
  clear || true
  printf '\033[1;95m+==================================================================+\033[0m\n'
  printf '\033[1;95m|                     BEM-VINDO AO RUINDOWS95                       |\033[0m\n'
  printf '\033[1;95m|                  Instalador offline baseado em Arch             |\033[0m\n'
  printf '\033[1;95m+==================================================================+\033[0m\n'
  printf '\033[1;95m|  Modo de inicialização: %-42s|\033[0m\n' "$mode"
  printf '\033[1;95m|  Compatibilidade: BIOS Legacy e UEFI 64 bits                    |\033[0m\n'
  printf '\033[1;95m|  Atenção: a instalação limpa APAGA o disco selecionado.         |\033[0m\n'
  printf '\033[1;95m|  Sem dual boot nesta versão.                                    |\033[0m\n'
  printf '\033[1;95m+==================================================================+\033[0m\n\n'
  echo 'Instalação offline: todos os arquivos já estão dentro da ISO.'
  echo 'Pressione Enter para continuar ou Ctrl+C para sair.'
  read -r _
}
welcome
payload=/usr/share/ruindows95
[[ -s "$payload/system.tar.xz" && -s "$payload/system.sha256" ]] || { echo 'Imagem offline ausente. Disco não alterado.'; exit 1; }
echo 'Verificando integridade do sistema offline...'
(cd "$payload" && sha256sum -c system.sha256) || { echo 'Imagem corrompida. Disco não alterado.'; exit 1; }
mapfile -t disks < <(while read -r d; do if safe_disk "$d"; then echo "$d"; fi; done < <(lsblk -dnpo NAME))
((${#disks[@]})) || { echo 'Nenhum disco elegível (mínimo 16 GiB, sem montagens).'; exit 1; }
ask() { read -r -p "$1" "$2" || { echo 'Entrada encerrada. Nenhum disco alterado.'; exit 1; }; }
title '1 / 6 — Disco de destino'
for i in "${!disks[@]}"; do printf '%s) ' "$((i+1))"; lsblk -dnpo NAME,SIZE,MODEL,SERIAL "${disks[i]}"; done
while :; do
  ask 'Número do disco (ou q para sair): ' choice
  [[ $choice != q ]] || exit 0
  if [[ $choice =~ ^[1-9][0-9]*$ && ${#choice} -le 4 ]] && ((choice <= ${#disks[@]})); then break; fi
  echo 'Escolha um número da lista.'
done
disk=${disks[choice-1]}
title '2 / 6 — Conta de usuário'
while :; do
  ask 'Nome do usuário: ' username
  [[ $username =~ ^[a-z][a-z0-9_-]{0,30}$ && $username != root && $username != live ]] && break
  echo 'Use letras minúsculas, números, hífen ou sublinhado. Comece com letra.'
done
while :; do
  read -rsp 'Senha (mínimo 4 caracteres): ' pass || exit 1; echo
  read -rsp 'Repita a senha: ' pass2 || exit 1; echo
  if [[ ${#pass} -ge 4 && $pass == "$pass2" && $pass != *:* ]]; then break; fi
  echo 'Use pelo menos 4 caracteres, sem dois-pontos, e repita a mesma senha.'
done
unset pass2
title '3 / 6 — Teclado'
while :; do
  echo '1) Português Brasil — ABNT2'
  echo '2) Inglês — Estados Unidos (US)'
  ask 'Escolha o layout [1-2]: ' keyboard_choice
  case "$keyboard_choice" in
    1) keymap=br-abnt2; xkb_layout=br; xkb_model=abnt2; keyboard_name='Português Brasil (ABNT2)'; break ;;
    2) keymap=us; xkb_layout=us; xkb_model=pc105; keyboard_name='Inglês Estados Unidos (US)'; break ;;
    *) echo 'Escolha 1 ou 2.' ;;
  esac
done
title '4 / 6 — Drivers'
while :; do
  echo '1) Automático / Genérico (recomendado)'
  echo '2) Intel / AMD (open-source)'
  echo '3) NVIDIA (Nouveau open-source)'
  echo '4) Máquina virtual (KVM / QEMU / SPICE)'
  ask 'Escolha o perfil de drivers [1-4]: ' driver_choice
  case "$driver_choice" in
    1) driver_profile=auto; driver_name='Automático / Genérico'; break ;;
    2) driver_profile=intel_amd; driver_name='Intel / AMD'; break ;;
    3) driver_profile=nvidia; driver_name='NVIDIA (Nouveau)'; break ;;
    4) driver_profile=vm; driver_name='Máquina virtual'; break ;;
    *) echo 'Escolha 1, 2, 3 ou 4.' ;;
  esac
done

title '5 / 6 — Computador'
while :; do
  ask 'Nome do computador [ruindows95]: ' host; host=${host:-ruindows95}
  [[ $host =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ && $host != *- ]] && break
  echo 'Nome inválido. Tente novamente.'
done
title '6 / 6 — Revisão e confirmação'
printf 'Modo: %s\nDisco: %s\nUsuário: %s\nComputador: %s\nTeclado: %s\nDrivers: %s\n' "$mode" "$disk" "$username" "$host" "$keyboard_name" "$driver_name"
lsblk -o NAME,SIZE,MODEL,FSTYPE,MOUNTPOINTS "$disk"
printf '\033[1;31mATENÇÃO: TODOS os dados de %s serão apagados.\033[0m\n' "$disk"
while :; do
  ask 'Digite APAGAR para confirmar ou CANCELAR para sair: ' confirm
  case "${confirm^^}" in
    APAGAR) break ;;
    CANCELAR|Q) echo 'Cancelado pelo usuário.'; exit 0 ;;
    *) echo 'Confirmação não reconhecida. Nenhum disco alterado. Tente novamente.' ;;
  esac
done
safe_disk "$disk" || { echo 'O disco mudou de estado. Cancelado.'; exit 1; }
mountpoint -q /mnt && { echo '/mnt já está montado. Cancelado.'; exit 1; }
trap 'rc=$?; if ((rc)); then echo "Instalação falhou (código $rc). Não reinicie até verificar o erro."; fi; unset pass; if mountpoint -q /mnt; then umount -R /mnt || true; fi' EXIT
# GPT layout: BIOS embedding area, EFI system partition, root.
sgdisk --zap-all "$disk"
sgdisk -n 1:2048:+2M -t 1:ef02 -n 2:0:+1G -t 2:ef00 -n 3:0:0 -t 3:8300 "$disk"
partprobe "$disk"; udevadm settle
part() { lsblk -nrpo NAME,PARTN "$disk" | awk -v n="$1" '$2==n {print $1; exit}'; }
esp=$(part 2); root=$(part 3); [[ -b "$esp" && -b "$root" ]]
mkfs.fat -F 32 "$esp"; mkfs.ext4 -F "$root"
mount "$root" /mnt; mkdir -p /mnt/boot/efi; mount "$esp" /mnt/boot/efi
echo 'Extraindo sistema offline para o disco...'
xz -dc "$payload/system.tar.xz" | tar --numeric-owner --acls --xattrs --xattrs-include='*' -xpf - -C /mnt
# Fresh keyring, populated with keys already shipped in archlinux-keyring.
arch-chroot /mnt pacman-key --init
arch-chroot /mnt pacman-key --populate archlinux

genfstab -U /mnt > /mnt/etc/fstab
ln -sf /usr/share/zoneinfo/America/Sao_Paulo /mnt/etc/localtime
sed -i 's/^#pt_BR.UTF-8 UTF-8/pt_BR.UTF-8 UTF-8/;s/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /mnt/etc/locale.gen
arch-chroot /mnt locale-gen
printf 'LANG=pt_BR.UTF-8\n' > /mnt/etc/locale.conf
printf 'KEYMAP=%s\n' "$keymap" > /mnt/etc/vconsole.conf
mkdir -p /mnt/etc/X11/xorg.conf.d
cat > /mnt/etc/X11/xorg.conf.d/00-keyboard.conf <<KEYBOARD
Section "InputClass"
    Identifier "system-keyboard"
    MatchIsKeyboard "on"
    Option "XkbLayout" "$xkb_layout"
    Option "XkbModel" "$xkb_model"
EndSection
KEYBOARD
printf '%s\n' "$host" > /mnt/etc/hostname
printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s.localdomain %s\n' "$host" "$host" > /mnt/etc/hosts
arch-chroot /mnt useradd -m -G wheel -s /bin/bash "$username"
printf '%s:%s\n' "$username" "$pass" | arch-chroot /mnt chpasswd
unset pass
arch-chroot /mnt passwd -l root
printf '%%wheel ALL=(ALL:ALL) ALL\n' > /mnt/etc/sudoers.d/10-wheel; chmod 440 /mnt/etc/sudoers.d/10-wheel
for f in usr/share/backgrounds/ruindows95/wallpaper.png usr/share/ruindows95/fastfetch-logo.png usr/local/bin/ruindows-wallpaper etc/xdg/autostart/ruindows-wallpaper.desktop etc/lightdm/lightdm-gtk-greeter.conf.d/50-ruindows.conf; do install -D -m "$(stat -c %a /$f)" "/$f" "/mnt/$f"; done
mkdir -p /mnt/etc/lightdm/lightdm.conf.d
printf '[Seat:*]\nuser-session=xfce\n' > /mnt/etc/lightdm/lightdm.conf.d/50-ruindows.conf
arch-chroot /mnt systemctl enable NetworkManager lightdm bluetooth
# Start the local print service on demand, without running it continuously.
arch-chroot /mnt systemctl enable cups.socket
arch-chroot /mnt systemctl set-default graphical.target
mkdir -p /mnt/etc/X11/xorg.conf.d /mnt/etc/modprobe.d
case "$driver_profile" in
  auto)
    printf '# Perfil automático: usar autodetecção do kernel e do Xorg.\n' > /mnt/etc/ruindows-driver-profile
    virt=$(systemd-detect-virt --vm || true)
    case "$virt" in
      kvm|qemu) arch-chroot /mnt systemctl enable spice-vdagentd.service qemu-guest-agent.service || true ;;
    esac
    ;;
  intel_amd)
    printf '# Perfil Intel/AMD selecionado pelo instalador.\n' > /mnt/etc/ruindows-driver-profile
    ;;
  nvidia)
    printf '# Perfil NVIDIA open-source (nouveau).\nblacklist nvidia\nblacklist nvidia_drm\nblacklist nvidia_modeset\nblacklist nvidia_uvm\n' > /mnt/etc/modprobe.d/ruindows-nvidia-open.conf
    printf '# Perfil NVIDIA (Nouveau) selecionado pelo instalador.\n' > /mnt/etc/ruindows-driver-profile
    ;;
  vm)
    printf '# Perfil de máquina virtual selecionado pelo instalador.\n' > /mnt/etc/ruindows-driver-profile
    arch-chroot /mnt systemctl enable spice-vdagentd.service || true
    arch-chroot /mnt systemctl enable qemu-guest-agent.service || true
    ;;
esac
arch-chroot /mnt pacman -Q linux-lts
arch-chroot /mnt mkinitcpio -P
test -s /mnt/boot/vmlinuz-linux-lts
test -s /mnt/boot/initramfs-linux-lts.img
if [[ $mode == UEFI ]]; then
  arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=Ruindows95 || arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --no-nvram
else
  arch-chroot /mnt grub-install --target=i386-pc "$disk"
fi
sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Ruindows95"/' /mnt/etc/default/grub
arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg
grep -Eq '^[[:space:]]*linux(efi)?[[:space:]]+[^[:space:]]*vmlinuz-linux-lts([[:space:]]|$)' /mnt/boot/grub/grub.cfg || { echo 'GRUB não encontrou o kernel LTS.'; exit 1; }
sync; umount -R /mnt
printf '\n\033[1;32mInstalação concluída com sucesso!\033[0m\n'
printf 'Teclado configurado: %s\n' "$keyboard_name"
printf 'Retire o pendrive antes de iniciar o sistema instalado.\n'
while :; do
  read -r -p 'Deseja reiniciar agora? [s/N]: ' reboot_answer || reboot_answer=n
  case "${reboot_answer,,}" in
    s|sim|y|yes) sync; systemctl reboot; break ;;
    n|nao|não|"") echo 'Tudo pronto. Você pode reiniciar manualmente quando quiser.'; break ;;
    *) echo 'Responda s para sim ou n para não.' ;;
  esac
done
